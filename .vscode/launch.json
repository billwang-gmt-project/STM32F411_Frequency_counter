{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "executable": "${workspaceFolder}/build/Debug/FanTestKit.elf",
            "cwd": "${workspaceFolder}",
            "device": "STM32F411CE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "runToEntryPoint": "main",
            "svdFile": "STM32F411.svd",
            "showDevDebugOutput": "parsed",
            "preLaunchTask": "Build (Debug)"
        }
    ]
}
